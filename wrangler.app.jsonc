{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "settledsolo",
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "settledsolo.com",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist-v2",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS_DB",
      "database_name": "settledsolo-accounts-production",
      "database_id": "dacd0934-58b0-43de-9306-25b467bc0aea",
      "migrations_dir": "migrations/accounts"
    }
  ],
  "ratelimits": [
    {
      "name": "PUSH_RATE_LIMITER",
      "namespace_id": "18002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "17002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "OTP_RATE_LIMITER",
      "namespace_id": "17004",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    "SITE_URL": "https://settledsolo.com",
    "ACCOUNTS_ENABLED": "true",
    "AUTH_ORIGIN": "https://settledsolo.com",
    "AUTH_EMAIL_FROM": "SettledSolo <login@auth.settledsolo.com>"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RETURN_ALERTS",
        "class_name": "ReturnAlertScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "return-alerts-v1",
      "new_sqlite_classes": [
        "ReturnAlertScheduler"
      ]
    }
  ]
}
