{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "settledsolo-web",
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "settledsolo.com",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist-v2",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "PUSH_RATE_LIMITER",
      "namespace_id": "18002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "SITE_URL": "https://settledsolo.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RETURN_ALERTS",
        "class_name": "ReturnAlertScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "return-alerts-v1",
      "new_sqlite_classes": [
        "ReturnAlertScheduler"
      ]
    }
  ]
}
